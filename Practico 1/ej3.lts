MEETING = (hello -> converse -> godbye -> STOP).

JOB = (arrive -> work -> leave -> JOB).

MOVIE = (ahead -> (right -> MOVIE | left -> STOP)).

GAME2 = ( tree -> lose -> GAME2 | {one, two} -> win -> GAME2 ).

GAME = (tree -> ESTADO1 | {one, two} -> ESTADO2),
ESTADO1 = (lose -> GAME),
ESTADO2 = (win -> GAME).

FOURTICK = (tick -> tick -> tick -> tick -> STOP).

DOUBLE = (in[i:1..3] -> out[i] -> DOUBLE).

PERSON = ( weekend -> sleep -> {play,shop} -> PERSON | weekend -> sleep -> work -> PERSON ).
