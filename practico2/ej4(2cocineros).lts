// Ejercicio 4
//	The Dining Savages: Una tribu de salvajes disfruta de una cena comunitaria. 
//	Cada uno se sirve de una gran olla que contiene hasta M porciones de estofado de misionero.
//	Cuando un salvaje quiere comer se sirve una porcion de la olla al menos que esta este vacıa en cuyo caso espera hasta que esta se vuelva a llenar.
//	Si la olla se vacıa, el cocinero de la tribu la vuelve a llenar con M porciones.
//	Modele los salvajes, el cocinero y la olla.

//Agregamos un cocinero

const N = 5 // Salvajes
const M = 3 // Porciones
const C = 2 //Cocineros


SALVAJE = (servir -> comer -> SALVAJE).	//comer es un estado al pedo?

OLLA = OLLA[M],
OLLA[i:0..M] = 	(when (i>0) servir -> OLLA[i-1]
				| when (i==0) llenar -> OLLA[M]).

COCINERO = (cocinar -> llenar -> COCINERO). //cocinar es un estado al pedo?

||CENA = (OLLA || cocineros[1..C]:COCINERO || salvajes[1..N]:SALVAJE)
/{
    // Todos los N salvajes mapean su accion 'servir' a la accion compartida 'servir' de la OLLA
    salvajes[1..N].servir / servir,
	// Todos los C cocineros mapean su accion 'llenar' a la accion compartida 'llenar' de la OLLA
	cocineros[1..C].llenar / llenar
}