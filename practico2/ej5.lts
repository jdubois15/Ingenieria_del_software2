// Ejercicio 5 
// Diseñe y modele en FSP un protocolo de comunicacion que permita a un proceso productor y un proceso consumidor 
// comunicarse a traves de un canal asincronico con un numero maximo
// de mensajes, de manera que el productor se bloquee cuando el buffer del canal esta lleno.

const M = 3 //numero maximo mensajes

PRODUCTOR = (producir -> enviar -> PRODUCTOR).

CONSUMIDOR = (recibir -> consumir -> CONSUMIDOR).

BUFFER = BUFFER[0],
BUFFER[i:0..M] =	( when (i<M) enviar  -> BUFFER[i+1]
					| when (i>0) recibir -> BUFFER[i-1]).

||SISTEMA = (PRODUCTOR || BUFFER || CONSUMIDOR).